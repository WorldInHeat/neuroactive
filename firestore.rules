rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // App user data
    match /artifacts/{appId}/users/{uid}/userData/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Push-notification device installation ownership (Phase 3A-1, third repair).
    // Authoritative and server-written ONLY — see functions/src/pushInstallations.ts
    // (initializePushInstallation / registerPushInstallation / revokePushInstallation /
    // preparePushInstallationTransfer / claimPushInstallationTransfer /
    // cancelPushInstallationTransfer), which bypass these rules entirely via the Admin SDK.
    // Keyed purely by installationId (no uid segment in the path at all), so there is
    // structurally only ever one document per installation — dual ownership under two
    // different uids is not just disallowed, it's impossible to represent in this schema.
    // Clients never write this collection directly: mutating an ALREADY-ACTIVE installation
    // requires possession of a server-issued, per-installation random lease that only the
    // callables above ever verify or rotate — a client-side rule has no way to express
    // "hash the presented credential and compare it to a previously stored hash inside an
    // atomic transaction" the way the callables' Firestore transactions do. No client read
    // is needed either — the Settings UI derives its state entirely from each callable's own
    // return value (including the lease/transfer credential itself, returned once, directly
    // to the caller entitled to hold it) plus local Notification.permission/auth state,
    // never from reading this collection back.
    match /artifacts/{appId}/pushInstallations/{installationId} {
      allow read, write: if false;
    }

    // Per-uid abuse-control counters (active-installation cap + initialize cooldown) for the
    // callables above. Server-written only, for the same reason as pushInstallations —
    // trusting a client-supplied count would defeat the entire point of the cap.
    match /artifacts/{appId}/pushInstallationRateLimits/{uid} {
      allow read, write: if false;
    }

    // FCM-token uniqueness index — keyed by a hash of the token, never the raw token — that
    // ensures one push endpoint can never be authoritatively active for more than one
    // installation (or, transitively, more than one uid) at a time. Enforced entirely inside
    // registerPushInstallation's transaction (see functions/src/pushInstallations.ts);
    // server-written only, same as the other two collections above.
    match /artifacts/{appId}/pushTokenClaims/{tokenHash} {
      allow read, write: if false;
    }

    // Server-controlled entitlement (e.g. DNS Foundations access). Only Cloud Functions,
    // via the Admin SDK (which bypasses these rules entirely), ever write this — the
    // owner may read their own entitlement but can never write or forge it.
    match /artifacts/{appId}/users/{uid}/entitlement/{doc} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Reminder preferences (Phase 3A-3, Step 1). Same trust shape as entitlement above:
    // owner-read only, write denied entirely. The client never writes this document
    // directly — the only path is the updateNotificationPreferences callable (Admin SDK,
    // bypasses these rules), which re-validates every field and is the sole computer of
    // nextReminderDueAt. A field-level rule permitting client writes to some fields but
    // not nextReminderDueAt was deliberately rejected in favor of this callable-only
    // boundary — simpler to reason about and impossible for a future field to accidentally
    // fall outside the intended protection.
    match /artifacts/{appId}/users/{uid}/notificationPreferences/{doc} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Reminder occurrence records (Phase 3A-3, Step 2). Server-written only, by the
    // scheduled function in functions/src/reminderScheduler.ts (Admin SDK, bypasses
    // these rules entirely) — no client read UI exists for these yet, so unlike
    // notificationPreferences/entitlement above there is no concrete reason to grant
    // owner-read either. Add owner-read later only if/when an in-app reminder-history
    // feature is actually built. No client write path exists or is intended.
    match /artifacts/{appId}/reminders/{reminderId} {
      allow read, write: if false;
    }

    // Reminder delivery-attempt records (Phase 3A-3 Step 3C-2). Server-written only, by
    // future delivery orchestration (functions/src/reminderDeliveryWorker.ts, Admin SDK,
    // bypasses these rules entirely — NOT wired to any deployed Cloud Function yet). NOT
    // covered by the parent `reminders/{reminderId}` match above: Firestore rule matches
    // are not recursive into subcollections unless a `{document=**}` wildcard is used, so
    // an explicit deny is added here for the same audit-clarity reasons every other
    // server-only collection in this file has one, even though an unmatched path is
    // already denied by Firestore's own default-deny behavior.
    match /artifacts/{appId}/reminders/{reminderId}/deliveries/{installationId} {
      allow read, write: if false;
    }

    // Server-owned notification rollout configuration (Phase 3A-3 Step 3C-3). Single fixed
    // document read by both reminderScheduler.ts (fanout decision) and
    // reminderDeliveryAuth.ts (final-authorization revalidation), Admin SDK only. No client
    // read or write — an allowlist a client could read would leak who else is enrolled, and
    // client write access would trivially let any user enable real sends for themselves.
    // Missing/malformed reads already fail closed to 'paused' semantics in application code
    // (see reminderDeliveryLogic.ts's parseRolloutConfig), so this document need not even
    // exist yet for that fail-closed behavior to hold — this rule denies access to it either way.
    match /artifacts/{appId}/systemConfig/notificationRollout {
      allow read, write: if false;
    }

    // Calendar subscription owner-facing management metadata (Calendar Integration Phase 1,
    // Stage 1). Owner-read only — the client never writes this document directly; the only
    // paths are createCalendarSubscription/revokeCalendarSubscription/
    // revokeAllCalendarSubscriptions (Admin SDK, bypasses these rules) and the
    // onCalendarUserDeleted Auth-deletion trigger. Same trust shape as notificationPreferences/
    // entitlement above. Contains a SHA-256 hash of the subscription secret (never the raw
    // secret itself) — safe for the owner to read, since a hash cannot be reversed into the
    // credential it was derived from.
    match /artifacts/{appId}/users/{uid}/calendarSubscriptions/{subscriptionId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Calendar subscription secret-hash lookup index (Calendar Integration Phase 1, Stage 1).
    // Server-only, same shape/reasoning as pushTokenClaims above. No client read (would leak
    // other users' uid/subscriptionId pairs keyed by hash) or write (would let a client forge
    // a working calendar credential). No public feed endpoint exists yet in Stage 1 — this
    // collection is currently written and deleted only by the callables/trigger in
    // functions/src/calendarSubscriptions.ts, never yet read by anything.
    match /artifacts/{appId}/calendarSubscriptionsByHash/{hash} {
      allow read, write: if false;
    }

    // Calendar per-uid deletion tombstone / account-state (Calendar Integration Phase 1,
    // Stage 1, Codex repair pass 2 — closes a create-versus-account-deletion race). Fully
    // server-only: no client may read this collection, since the mere ability to check
    // whether a tombstone exists for a given uid would let anyone probe which accounts have
    // been deleted. Written only by the onCalendarUserDeleted trigger (sets it, permanently)
    // and read only inside that trigger's and createCalendarSubscriptionCore's own Firestore
    // transactions in functions/src/calendarSubscriptions.ts.
    match /artifacts/{appId}/calendarAccountState/{uid} {
      allow read, write: if false;
    }

    // Stripe customer data (written by the Firebase Stripe extension)
    match /customers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['stripeId', 'stripeLink']);
      allow update: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['stripeId', 'stripeLink']);
      allow delete: if false;

      match /checkout_sessions/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /subscriptions/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }

      match /payments/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }

      match /portal_links/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
