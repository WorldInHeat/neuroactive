{
  "name": "functions",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\"",
    "clean:test": "node -e \"require('fs').rmSync('lib-test', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "build:test": "npm run clean:test && tsc -p tsconfig.test.json",
    "build:watch": "tsc --watch",
    "test": "npm run build:test && node --test lib-test/*.test.js",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "google-auth-library": "^10.9.1",
    "stripe": "22.5.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
